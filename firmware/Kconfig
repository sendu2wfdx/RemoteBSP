    default y if BOARD_MELLOW_FLY_D5
    default n
config MOTION_SLOT4_LIMIT_PIN
    int "槽 4 限位引脚"
    range -1 63
    default -1
endif

endmenu
endif

config MOTION_MAX_AXES
    int "本板最大运动轴数"
    range 1 5
    default 5 if BOARD_MELLOW_FLY_D5
    default 4 if BOARD_STM32F072RBT6
    default 2 if BOARD_STM32F103CBT6
    default 5 if BOARD_STM32G431CBU6
    depends on REMOTEBSP_MOTION
    help
      这是本节点编译期存储上限，不是整个系统的轴数上限。当前 F072/F103/G431
      板级适配各提供五个可配置槽；实际启用槽数量不能超过
      此值；逻辑运动组可组合多块板卡。

config MOTION_QUEUE_DEPTH
    int "运动段队列深度"
    range 2 128
    default 8 if BOARD_STM32F072RBT6
    default 8 if BOARD_STM32F103CBT6
    default 32 if BOARD_STM32G431CBU6
    depends on REMOTEBSP_MOTION

config MOTION_MIN_LEAD_TIME_US
    int "最小排程提前量（微秒）"
    range 100 1000000
    default 2000 if BOARD_STM32F072RBT6
    default 2000 if BOARD_STM32F103CBT6
    default 1000 if BOARD_STM32G431CBU6
    depends on REMOTEBSP_MOTION

config MOTION_TIMER_HZ
    int "STEP 执行器定时中断频率"
    range 1000 500000
    default 100000 if BOARD_STM32F072RBT6
    default 100000 if BOARD_STM32F103CBT6
    default 200000 if BOARD_STM32G431CBU6
    depends on REMOTEBSP_MOTION
    help
      STEP 脉冲高、低电平各至少保持一个定时周期，因此单轴理论最大步频为此值一半。

config MOTION_SLOT_LIMIT_INPUTS
    bool "启用槽 0～2 的固定限位输入"
    default n
    depends on REMOTEBSP_MOTION && BOARD_STM32F072RBT6

endmenu
config HARDWARE_ID_ADC
    bool "启用 ADC 硬件 ID"
    default n

menu "USB 调试"

config USB_DEBUG_CDC
    bool "启用 USB CDC 非阻塞调试输出"
    default n
    depends on BOARD_STM32G431CBU6 && CAN_PINS_PB8_PB9
    help
      使用 PA11/PA12 枚举为 USB CDC ACM 虚拟串口。发送采用环形缓冲，
      缓冲已满时丢弃新的调试字节，不允许调试输出阻塞 CAN 主循环。
      STM32G431 可与 FDCAN 同时运行，CAN 必须使用 PB8/PB9。
      STM32F103 的 USB 与 bxCAN 共用 512 字节专用 SRAM，硬件不允许
      两者同时运行，因此 F103 的 CAN APP 不提供此选项；USB Katapult
      Bootloader 仍可单独使用。

config USB_DEBUG_TX_BUFFER_SIZE
    int "USB 调试发送环形缓冲长度"
    range 128 2048
    default 1024 if BOARD_STM32G431CBU6
    depends on USB_DEBUG_CDC

config USB_DEBUG_VID
    hex "USB VID（开发默认值，产品化前必须替换）"
    default 0x0483
    depends on USB_DEBUG_CDC

config USB_DEBUG_PID
    hex "USB PID（开发默认值，产品化前必须替换）"
    default 0x5740
    depends on USB_DEBUG_CDC

endmenu

choice
    prompt "APP Flash 布局"
    default APP_LAYOUT_STANDALONE
    help
      独立 APP 从 0x08000000 启动，适合使用 ST-Link 直接烧录。
      Katapult 布局为 Bootloader 保留前 8KiB，APP 从 0x08002000 启动。

config APP_LAYOUT_STANDALONE
    bool "独立 APP（无 Bootloader，偏移 0）"

config APP_LAYOUT_KATAPULT_8K
    bool "Katapult Bootloader（保留前 8KiB）"

endchoice

config APPLICATION_FLASH_OFFSET
    hex
    default 0x2000 if APP_LAYOUT_KATAPULT_8K
    default 0x0
