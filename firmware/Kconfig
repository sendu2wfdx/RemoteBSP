    int "固件次版本号"
    range 0 65535
    default 1

config FIRMWARE_VERSION_PATCH
    int "固件修订版本号"
    range 0 65535
    default 0

config BOARD_TYPE
    hex
    default 0xF072D5 if BOARD_MELLOW_FLY_D5
    default 0x0072B6 if BOARD_STM32F072RBT6
    default 0x0103CB if BOARD_STM32F103CBT6
    default 0x0431CB if BOARD_STM32G431CBU6

config NODE_PROVISIONAL_ID
    int "未分配节点的临时编号"
    range 1 127
    default 1

endmenu

menu "主通信链路"

choice
    prompt "APP 主通信链路"
    default REMOTEBSP_TRANSPORT_CAN

config REMOTEBSP_TRANSPORT_CAN
    bool "CAN / CAN-FD"

config REMOTEBSP_TRANSPORT_USB
    bool "USB Vendor Bulk（STM32G431CBU6）"
    depends on BOARD_STM32G431CBU6
    help
      使用 PA11/PA12 作为 RemoteBSP 正常运行链路。已实现公共帧格式、Linux
      libusb 主机、Mock 端到端链路及 G431 USB Device Vendor Bulk 后端；实体
      G431 的枚举、重连和压力测试仍待实板验收。F072/F103 暂不开放本选项。

endchoice

config USB_VENDOR_ID
    hex "USB VID"
    default 0x1209
    depends on REMOTEBSP_TRANSPORT_USB
    help
      0x1209 仅作为开发占位值，发布产品前必须申请或使用合法分配的 VID/PID。

config USB_PRODUCT_ID
    hex "USB PID"
    default 0x0001
    depends on REMOTEBSP_TRANSPORT_USB

config USB_RX_BUFFER_SIZE
    int "USB 原始接收缓冲区" if EXPERT_CONFIG
    range 3072 8192
    default 3072
    depends on REMOTEBSP_TRANSPORT_USB
    help
      至少容纳一个最大 Remote Packet 拆分后的全部 RBU1 逻辑帧，避免主循环
      暂时繁忙时 Bulk OUT 连续到达造成半包丢失。

config USB_TX_BUFFER_SIZE
    int "USB 原始发送缓冲区" if EXPERT_CONFIG
    range 3072 8192
    default 3072
    depends on REMOTEBSP_TRANSPORT_USB
    help
      Remote Core 会连续提交同一响应的所有分片，因此缓冲必须容纳 2048 字节
      Remote Packet 加每个逻辑帧的 12 字节 RBU1 帧头。

endmenu

