menu "PWM 与定时位流（可选）"

config REMOTEBSP_PWM
    bool "编译通用 PWM 输出模块"
    default n
    depends on BOARD_STM32F072RBT6 || BOARD_STM32F103CBT6 || BOARD_STM32G431CBU6
    help
      提供频率、占空比和有效极性可配置的远程 PWM 对象。关闭后不分配对象状态，
      板级定时器后端也不会接入 Remote Core。

config PWM_RESOURCE_COUNT
    int "PWM 通道编译期容量"
    range 1 1 if BOARD_STM32F072RBT6 || BOARD_STM32F103CBT6
    range 1 2 if BOARD_STM32G431CBU6
    default 1
    depends on REMOTEBSP_PWM

choice
    prompt "PWM 0 输出引脚"
    depends on REMOTEBSP_PWM
    default PWM0_PIN_PA6 if BOARD_STM32F072RBT6 || BOARD_STM32F103CBT6
    default PWM0_PIN_PB10 if BOARD_STM32G431CBU6 && PWM_RESOURCE_COUNT > 1
    default PWM0_PIN_PC6 if BOARD_STM32G431CBU6

config PWM0_PIN_PA6
    bool "PA6（TIM3_CH1）"
    depends on BOARD_STM32F072RBT6 || BOARD_STM32F103CBT6 || BOARD_STM32G431CBU6
    depends on PWM_RESOURCE_COUNT = 1
    depends on !REMOTEBSP_MOTION || !MOTION_PIN_PA6_USED_25

config PWM0_PIN_PC6
    bool "PC6（TIM3_CH1，WeAct G431 板载 LED）"
    depends on BOARD_STM32G431CBU6 && PWM_RESOURCE_COUNT = 1
    depends on !REMOTEBSP_MOTION || !MOTION_PIN_PC6_USED_25

config PWM0_PIN_PB10
    bool "PB10（TIM2_CH3，与 USART3 TX 互斥）"
    depends on BOARD_STM32G431CBU6 && PWM_RESOURCE_COUNT = 2
    depends on HARDWARE_UART_RESOURCE_COUNT < 3
    depends on !REMOTEBSP_MOTION

endchoice

config PWM1_PIN_PB11
    bool
    default y
    depends on PWM0_PIN_PB10 && PWM_RESOURCE_COUNT = 2
    help
      PWM 1 固定使用 PB11（TIM2_CH4）。它与 PWM 0 共享 TIM2 频率，且
      PB10/PB11 与 USART3 互斥，因此双 PWM 配置最多启用两路硬件 UART。

config PWM_MAX_FREQUENCY_HZ
    int "PWM 允许的最高频率（Hz）"
    range 1000 2000000
    default 100000
    depends on REMOTEBSP_PWM
    help
      这是协议校验上限，不代表每个引脚都能达到该频率；最终仍由所选定时器时钟和
      计数器分辨率决定。

config REMOTEBSP_TIMED_BITSTREAM
    bool "编译定时位流输出模块（WS2812 等）"
    default n
    depends on BOARD_STM32F072RBT6 || BOARD_STM32F103CBT6 || BOARD_STM32G431CBU6
    help
      MCU 只执行带 0/1 高电平宽度的通用定时位流，WS2812 的 RGB/GRB 顺序仍由
      Linux 负责。板级后端计划使用定时器 PWM 与 DMA，避免逐位中断阻塞 CAN。

config TIMED_BITSTREAM_RESOURCE_COUNT
    int "定时位流通道编译期容量"
    range 1 2
    default 1
    depends on REMOTEBSP_TIMED_BITSTREAM

choice
    prompt "定时位流 0 输出引脚"
    depends on REMOTEBSP_TIMED_BITSTREAM
    default TIMED_BITSTREAM0_PIN_PA8

config TIMED_BITSTREAM0_PIN_PA8
    bool "PA8（TIM1_CH1，DMA）"
    depends on !REMOTEBSP_MOTION || !MOTION_PIN_PA8_USED_25

endchoice

config TIMED_BITSTREAM_MAX_BITS
    int "单次定时位流最大位数"
    range 24 12288
    default 1536 if BOARD_STM32G431CBU6
    default 768
    depends on REMOTEBSP_TIMED_BITSTREAM
    help
      768 位可驱动 32 颗 RGB 灯，1536 位可驱动 64 颗。DMA 比较值缓冲区按此上限
      消耗静态 RAM；Studio 工程决定固件实际启用的灯珠数量。

endmenu

menu "智能步进运动（可选）"

config REMOTEBSP_MOTION
    bool "编译智能步进运动模块"
    default n
    depends on BOARD_STM32F072RBT6 || BOARD_STM32F103CBT6 || BOARD_STM32G431CBU6
    help
      启用带绝对时间的多轴运动段队列和定时器 STEP 执行器。关闭时不编译
      运动源文件，也不在 Remote Core 中分配轴状态和运动段队列。

      STM32F072RBT6、STM32F103CBT6 与 STM32G431CBU6 都有独立的 STEP 定时器后端。默认预设
      只负责填写已知接线；不选择预设时仍可手工配置本板运动槽和引脚。

config REMOTEBSP_TMC2209_UART
    bool "编译 TMC2209 专用单线 UART 后端"
    default n
    depends on REMOTEBSP_MOTION
    select REMOTEBSP_SOFT_HALF_DUPLEX_UART
    help
      编译固定 40000 bit/s 的单线半双工字节事务执行器。它与硬件 USART
      独立裁剪，可同时存在；TMC 寄存器语义、CRC 和初始化策略仍由 Linux 负责。

config TMC2209_UART_PORT_CAPACITY
    int "TMC2209 单线端口编译期容量"
    range 1 5
    default 5 if BOARD_MELLOW_FLY_D5
    default 1
    depends on REMOTEBSP_TMC2209_UART
    help
      这是静态状态和逻辑对象容量，不是必须启用的实际端口数。兼容期静态槽位中，
      最高 TMC 槽号必须小于本值；运行时资源清单完成后由清单决定实际端口。

if REMOTEBSP_MOTION

rsource "Kconfig.motion_pins.generated"

endif

config MOTION_MAX_AXES
    int "本板最大运动轴数"
    range 1 5
    default 5 if BOARD_MELLOW_FLY_D5
    default 4 if BOARD_STM32F072RBT6
    default 2 if BOARD_STM32F103CBT6
    default 5 if BOARD_STM32G431CBU6
    depends on REMOTEBSP_MOTION
    help
      这是本节点编译期存储上限，不是整个系统的轴数上限。当前 F072/F103/G431
      板级适配各提供五个可配置槽；实际启用槽数量不能超过
      此值；逻辑运动组可组合多块板卡。

config MOTION_QUEUE_DEPTH
    int "运动段队列深度" if EXPERT_CONFIG
    range 2 128
    default 8 if BOARD_STM32F072RBT6
    default 8 if BOARD_STM32F103CBT6
    default 32 if BOARD_STM32G431CBU6
    depends on REMOTEBSP_MOTION

config MOTION_MIN_LEAD_TIME_US
    int "最小排程提前量（微秒）" if EXPERT_CONFIG
    range 100 1000000
    default 2000 if BOARD_STM32F072RBT6
    default 2000 if BOARD_STM32F103CBT6
    default 1000 if BOARD_STM32G431CBU6
    depends on REMOTEBSP_MOTION

config MOTION_MAX_STEP_RATE_HZ
    int "单轴最大 STEP 频率预算" if EXPERT_CONFIG
    range 1000 250000
    default 30000 if BOARD_STM32F072RBT6
    default 60000 if BOARD_STM32F103CBT6
    default 120000 if BOARD_STM32G431CBU6
    depends on REMOTEBSP_MOTION
    help
      运动段入队时使用的单轴安全预算。它不是周期中断频率；compare 调度器只在
      实际边沿到期时进入中断。实板性能验收后可以针对板型提高该值。

config MOTION_MAX_TOTAL_STEP_RATE_HZ
    int "整板总 STEP 频率预算" if EXPERT_CONFIG
    range 1000 500000
    default 30000 if BOARD_STM32F072RBT6
    default 80000 if BOARD_STM32F103CBT6
    default 200000 if BOARD_STM32G431CBU6
    depends on REMOTEBSP_MOTION
    help
      所有轴 STEP 频率之和的入队上限，用来限制最坏情况下的 compare ISR 负载。
      同时到期的多轴边沿会在一次中断中批量处理，因此实际中断数通常更低。

config MOTION_STEP_PULSE_WIDTH_US
    int "STEP 高电平宽度（微秒）" if EXPERT_CONFIG
    range 1 100
    default 8 if BOARD_STM32F072RBT6
    default 5 if BOARD_STM32F103CBT6
    default 2 if BOARD_STM32G431CBU6
    depends on REMOTEBSP_MOTION

config MOTION_MIN_STEP_LOW_US
    int "STEP 最短低电平时间（微秒）" if EXPERT_CONFIG
    range 1 100
    default 8 if BOARD_STM32F072RBT6
    default 5 if BOARD_STM32F103CBT6
    default 2 if BOARD_STM32G431CBU6
    depends on REMOTEBSP_MOTION

config MOTION_DIRECTION_SETUP_US
    int "DIR 到首个 STEP 的建立时间（微秒）" if EXPERT_CONFIG
    range 1 100
    default 8 if BOARD_STM32F072RBT6
    default 5 if BOARD_STM32F103CBT6
    default 2 if BOARD_STM32G431CBU6
    depends on REMOTEBSP_MOTION

config MOTION_COMPARE_MIN_LEAD_US
    int "定时器 compare 最小提前量（微秒）" if EXPERT_CONFIG
    range 1 100
    default 4 if BOARD_STM32F072RBT6
    default 3 if BOARD_STM32F103CBT6
    default 1 if BOARD_STM32G431CBU6
    depends on REMOTEBSP_MOTION
    help
      写入 compare 后必须至少留出的硬件计数时间。过近的边沿会向后安全顺延，
      避免比较值已经落后于计数器而等待一次完整回绕。

config MOTION_MAX_COMPARE_LATENESS_US
    int "compare 最大容许迟到（微秒）" if EXPERT_CONFIG
    range 1 1000
    default 50 if BOARD_STM32F072RBT6
    default 30 if BOARD_STM32F103CBT6
    default 10 if BOARD_STM32G431CBU6
    depends on REMOTEBSP_MOTION
    help
      超出该预算时禁止突发补发 STEP，立即锁存时序故障并关闭运动输出。

config MOTION_SLOT_LIMIT_INPUTS
    bool "启用槽 0～2 的固定限位输入"
    default n
    depends on REMOTEBSP_MOTION && BOARD_STM32F072RBT6

endmenu
menu "启动与升级"

