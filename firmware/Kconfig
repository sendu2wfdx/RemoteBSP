mainmenu "Remote BSP 工具板固件配置"

config EXPERT_CONFIG
    bool "显示专家级容量与时序设置"
    default n
    help
      普通构建使用各 MCU 已验证的默认预算即可。只有在完成 SRAM、总线负载和
      实板时序验证后才应调整专家参数。

menu "目标硬件"

choice
    prompt "目标 MCU"
    default BOARD_STM32F103CBT6

config BOARD_STM32F103CBT6
    bool "STM32F103CBT6（128KB Flash / 20KB SRAM / bxCAN）"

config BOARD_STM32F072RBT6
    bool "STM32F072RBT6（128KB Flash / 16KB SRAM / bxCAN）"

config BOARD_STM32G431CBU6
    bool "STM32G431CBU6（128KB Flash / 32KB SRAM / FDCAN）"
endchoice

choice
    prompt "STM32F072RBT6 板型"
    depends on BOARD_STM32F072RBT6
    default BOARD_STM32F072RBT6_GENERIC

config BOARD_STM32F072RBT6_GENERIC
    bool "通用 STM32F072RBT6"

config BOARD_MELLOW_FLY_D5
    bool "Mellow FLY-D5"
    help
      仅为已知的 FLY-D5 接线预填 8MHz HSE、PB8/PB9 CAN、USB 保留和五个运动槽的
      默认引脚。通用 STM32F072RBT6 仍可手工配置相同功能。

endchoice

choice
    prompt "STM32F103CBT6 板型"
    depends on BOARD_STM32F103CBT6
    default BOARD_STM32F103CBT6_GENERIC

config BOARD_STM32F103CBT6_GENERIC
    bool "通用 STM32F103CBT6"

config BOARD_WEACT_BLUEPILL_PLUS
    bool "WeAct BluePill Plus"
    help
      PA0 为高电平按下的用户按键，使用 MCU 内部下拉；PB2 为高电平点亮
      的蓝色 LED；PA11/PA12 分别为 USB DM/DP。OSC_IN/OSC_OUT 接 8MHz
      HSE，PC14/PC15 接 32.768kHz LSE。

endchoice

choice F103_CLOCK_SOURCE
    prompt "STM32F103 系统时钟源"
    depends on BOARD_STM32F103CBT6
    default F103_CLOCK_HSE_8MHZ if BOARD_WEACT_BLUEPILL_PLUS
    default F103_CLOCK_HSI8

config F103_CLOCK_HSI8
    bool "内部 HSI8（PLL 到 64MHz）"
    help
      供没有外部高速晶振的通用核心板使用。SYSCLK 为 64MHz，APB1 和 bxCAN
      时钟为 32MHz。内部 RC 的频率精度和温漂不如外部晶振，不建议用于高速、
      长线或节点较多的 CAN 网络。

config F103_CLOCK_HSE_8MHZ
    bool "外部 8MHz HSE（PLL 到 72MHz，推荐）"
    help
      SYSCLK 为 72MHz，APB1 和 bxCAN 时钟为 36MHz。WeAct BluePill Plus
      默认选择本项；CAN 通讯和运动定时优先使用外部晶振。

endchoice

choice
    prompt "STM32G431CBU6 板型"
    depends on BOARD_STM32G431CBU6
    default BOARD_STM32G431CBU6_GENERIC

config BOARD_STM32G431CBU6_GENERIC
    bool "通用 STM32G431CBU6"

config BOARD_WEACT_G431_CORE_V10
    bool "WeAct STM32G431CBU6 Core"
    help
      PB8/BOOT0 带 10k 下拉，PB8/PB9 用于 FDCAN；PA11/PA12 用于
      USB DM/DP。PC13 用户按键高电平有效且无外部上下拉，PC6 蓝色
      LED 高电平点亮。PF0/PF1 接 8MHz HSE，PC14/PC15 接 32.768kHz LSE。

endchoice

config BOARD_HAS_LSE_32768
    bool "板卡安装 32.768kHz LSE 晶振"
    depends on BOARD_STM32F103CBT6 || BOARD_STM32G431CBU6
    default y if BOARD_WEACT_BLUEPILL_PLUS || BOARD_WEACT_G431_CORE_V10
    default n
    help
      声明 PC14/PC15 已连接低速外部晶振，并从 GPIO、运动和软件 UART 的
      可选引脚中保留它们。当前 APP 尚未使用 RTC/低功耗守时，因此只记录并
      保护这项硬件资源，不会无意义地启动 LSE；未来时间同步保持模块启用时
      再由该模块启动并检测 LSE。

choice F072_CLOCK_SOURCE
    prompt "STM32F072 系统时钟源"
    depends on BOARD_STM32F072RBT6
    default F072_CLOCK_HSE_8MHZ if BOARD_MELLOW_FLY_D5
    default F072_CLOCK_HSI48

config F072_CLOCK_HSI48
    bool "内部 HSI48"

config F072_CLOCK_HSE_8MHZ
    bool "外部 8MHz HSE（PLL 到 48MHz）"
    help
      本板默认使用 8MHz 外部晶振。CAN 使用外部晶振可满足 1Mbit/s 对节点时钟
      误差的要求；选择该项时 SYSCLK/PCLK1 仍为 48MHz。

endchoice

config F072_RESERVE_KATAPULT_USB_PINS
    bool "保留 PA11/PA12 给 Katapult USB 恢复口"
    depends on BOARD_STM32F072RBT6
    default y if BOARD_MELLOW_FLY_D5
    default n
    help
      启用后，普通 GPIO 与运动槽配置均不能占用 PA11/PA12。该选项只描述
      Katapult 应急恢复口的板级占用，不会把 USB 协议栈链接进 APP；FLY-D5
      默认映射会自动启用本项。

choice
    prompt "STM32G431 系统时钟源"
    depends on BOARD_STM32G431CBU6
    default G431_CLOCK_HSE_8MHZ if BOARD_WEACT_G431_CORE_V10
    default G431_CLOCK_HSI16

config G431_CLOCK_HSI16
    bool "内部 HSI16"

config G431_CLOCK_HSE_8MHZ
    bool "外部 8MHz HSE"
endchoice

menu "开发与板卡自检"

config WEACT_G431_PC6_PWM_BREATHING_LED
    bool "WeAct G431 PC6 PWM 呼吸灯演示"
    depends on BOARD_WEACT_G431_CORE_V10 && !REMOTEBSP_PWM
    default n
    help
      使用 TIM3_CH1（PC6，AF2）输出 10kHz PWM。亮度按约 4 秒一个
      周期缓慢起伏，用于验证定时器、PWM 输出和板载 LED。启用时 PC6
      被该演示独占，不能再作为远程 GPIO 使用；关闭后 PC6 恢复为普通 GPIO。

config WEACT_BLUEPILL_PLUS_PB2_BREATHING_LED
    bool "WeAct BluePill Plus PB2 软件呼吸灯演示"
    depends on BOARD_WEACT_BLUEPILL_PLUS
    default n
    help
      使用板载高电平点亮的 PB2 LED。PB2 不具备可直接使用的 PWM 输出通道，
      固件在主循环中依据 1ms 系统节拍产生约 100Hz 的软件 PWM，并按约 4 秒
      周期改变占空比。该实现不新增定时器中断，不影响 CAN 接收、UART 中断或
      可选的运动定时器。关闭后 PB2 保持熄灭，并继续保留为板载 LED。

endmenu

config SYSTEM_CLOCK_HZ
    int
    default 48000000 if BOARD_STM32F072RBT6
    default 72000000 if F103_CLOCK_HSE_8MHZ
    default 64000000 if F103_CLOCK_HSI8
    default 170000000 if BOARD_STM32G431CBU6

