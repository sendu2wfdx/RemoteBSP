menu "远程协议与内存预算"

config REMOTE_BUDGET_EDIT
    bool "编辑远程协议与内存预算"
    default n
    help
      默认值已经按当前三类 MCU 做过保守配置。只有需要改变最大包长、缓存数量
      或时序参数时才开启；下方每个选项都会显示用途和主要内存代价。

comment "当前使用经过验证的安全默认值；开启上面的开关后可查看和修改"
    depends on !REMOTE_BUDGET_EDIT && !EXPERT_CONFIG

config REMOTE_MAX_PACKET_SIZE
    int "最大远程协议包长度" if EXPERT_CONFIG || REMOTE_BUDGET_EDIT
    range 256 2048
    default 2048 if BOARD_STM32F072RBT6
    default 2048 if BOARD_STM32F103CBT6
    default 2048 if BOARD_STM32G431CBU6

config REMOTE_REQUEST_CACHE_ENTRIES
    int "请求去重缓存条目数" if EXPERT_CONFIG || REMOTE_BUDGET_EDIT
    range 2 32
    default 8 if BOARD_STM32F072RBT6
    default 8 if BOARD_STM32F103CBT6
    default 16 if BOARD_STM32G431CBU6

config REMOTE_CACHE_RESPONSE_SIZE
    int "单条去重缓存的最大响应长度" if EXPERT_CONFIG || REMOTE_BUDGET_EDIT
    range 64 512
    default 256
    help
      此长度包含 24 字节远程协议头。会消耗数据或产生副作用的命令，
      必须把完整响应限制在此长度内，才能保证重试不会重复执行操作。

config REMOTE_REASSEMBLY_SLOTS
    int "并行分片重组槽数量" if EXPERT_CONFIG || REMOTE_BUDGET_EDIT
    range 1 4
    default 2

config REMOTE_REASSEMBLY_TIMEOUT_MS
    int "分片重组超时（毫秒）" if EXPERT_CONFIG || REMOTE_BUDGET_EDIT
    range 50 5000
    default 500

config HEARTBEAT_INTERVAL_MS
    int "心跳间隔（毫秒）" if EXPERT_CONFIG || REMOTE_BUDGET_EDIT
    range 100 2000
    default 500

config REMOTEBSP_DEVICE_PARAMS
    bool "保存设备身份、制造信息和校准参数"
    default y
    help
      在芯片内部Flash末尾保留两个擦除页，使用掉电安全的快照日志保存
      SN、UUID、硬件版本、制造批次、设备名称和ADC校准值。这里不保存
      GPIO、UART、运动轴等资源映射；资源映射由Studio生成并编译进固件。
      存储接口与介质无关，可替换为外部EEPROM而不修改远程协议。

choice REMOTEBSP_DEVICE_PARAM_BACKEND
    prompt "设备参数存储后端"
    depends on REMOTEBSP_DEVICE_PARAMS
    default REMOTEBSP_DEVICE_PARAM_INTERNAL_FLASH

config REMOTEBSP_DEVICE_PARAM_INTERNAL_FLASH
    bool "内部Flash双页（默认）"

config REMOTEBSP_DEVICE_PARAM_EXTERNAL_EEPROM
    bool "板级注入的外部EEPROM"
    help
      仅启用通用read/write/erase-or-fill回调适配层；板级代码必须提供实际
      介质回调。本选项不包含I2C、SPI或厂商器件协议。
endchoice

config REMOTEBSP_DEVICE_PARAM_EEPROM_PAGE_SIZE
    int "外部EEPROM逻辑页大小"
    depends on REMOTEBSP_DEVICE_PARAM_EXTERNAL_EEPROM
    range 512 4096
    default 512

config REMOTEBSP_DEVICE_PARAM_COMMIT_BUDGET
    int "设备参数终身提交预算"
    depends on REMOTEBSP_DEVICE_PARAMS
    range 1 10000
    default 10000
    help
      固件允许的持久快照generation上限。只能在构建时选择，运行期只能进一步
      收紧，不能放宽；设备参数禁止承载高频遥测。

endmenu

menu "通用硬件资源"

menu "上电 IO 安全状态"

config REMOTEBSP_STATIC_GPIO_MAP
    bool "只允许访问已声明的 GPIO"
    default n
    help
      RemoteBSP Studio生成的产品固件应启用本项。启用后，GPIO_CREATE只能访问
      下方五个上电状态列表中的引脚，并且请求方向必须与列表声明一致。关闭时
      保留核心板调试固件的兼容行为，由板级驱动决定引脚是否合法。

config STARTUP_GPIO_OUTPUT_LOW
    string "启动后输出低的引脚列表"
    default ""
    help
      使用逗号分隔，例如 PA1,PB2。固件会先写入低电平锁存值，再把引脚
      切换为推挽输出，避免切换过程产生高电平毛刺。

config STARTUP_GPIO_OUTPUT_HIGH
    string "启动后输出高的引脚列表"
    default ""
    help
      使用逗号分隔，例如 PA3,PC13。固件会先写入高电平锁存值，再把引脚
      切换为推挽输出。

config STARTUP_GPIO_INPUT_FLOATING
    string "启动后浮空输入的引脚列表"
    default ""

config STARTUP_GPIO_INPUT_PULLUP
    string "启动后上拉输入的引脚列表"
    default ""

config STARTUP_GPIO_INPUT_PULLDOWN
    string "启动后下拉输入的引脚列表"
    default ""
    help
      五个列表都使用 PA0,PB2 形式。同一引脚不能重复，SWD、CAN、USB、UART
      等保留引脚不能配置；非法配置会让固件进入安全故障状态。

endmenu

config GPIO_RESOURCE_COUNT
    int "编译期最大 GPIO 资源数"
    range 0 32
    default 16 if BOARD_MELLOW_FLY_D5
    default 8

config GPIO_INPUT_EVENT_QUEUE_CAPACITY
    int "每个 GPIO 输入对象的本地事件队列容量"
    range 1 16
    default 2
    depends on GPIO_RESOURCE_COUNT > 0
    help
      输入去抖后的稳定边沿先进入固定容量本地队列，再由主循环上报。
      队列满时丢弃最新事件并累计溢出计数，不在中断中解析或发送协议。

config REMOTEBSP_GPIO_EXTI
    bool "启用显式静态 GPIO EXTI 端点"
    default n
    depends on REMOTEBSP_STATIC_GPIO_MAP && GPIO_RESOURCE_COUNT > 0
    help
      仅供能力目录标记为implemented并由Studio生成的独立EXTI端点使用。
      不会把普通GPIO输入隐式改为中断输入；未启用时不编译mailbox或板级IRQ状态。

config GPIO_EXTI_MAILBOX_CAPACITY
    int "GPIO EXTI ISR mailbox容量"
    range 1 16
    default 2
    depends on REMOTEBSP_GPIO_EXTI
    help
      ISR只投递静态编码引脚，满时丢弃最新提示并饱和累计计数。

config GPIO_EXTI0_PA0
    bool "F103 PA0 / EXTI0"
    default n
    depends on REMOTEBSP_GPIO_EXTI && BOARD_STM32F103CBT6

config GPIO_EXTI13_PC13
    bool "G431 PC13 / EXTI13"
    default n
    depends on REMOTEBSP_GPIO_EXTI && BOARD_STM32G431CBU6

config HARDWARE_UART_RESOURCE_COUNT
    int "编译期最大硬件 UART 资源数"
    range 0 3 if BOARD_STM32F103CBT6 || BOARD_STM32G431CBU6
    range 0 1 if BOARD_STM32F072RBT6
    default 0 if BOARD_MELLOW_FLY_D5
    default 1 if BOARD_STM32F072RBT6
    default 3 if BOARD_STM32F103CBT6
    default 3 if BOARD_STM32G431CBU6
    help
      F072 后端实现一组 USART1；F103 后端依次提供 USART1、USART2、USART3，
      G431后端同样依次提供USART1、USART2、USART3。数量设为1/2/3时只链接并
      占用对应的前N组资源。
      TMC2209单线通讯不计入这里，而是由智能运动菜单独立裁剪。

config UART_RESOURCE_COUNT
    int
    default HARDWARE_UART_RESOURCE_COUNT
    help
      生成配置头时自动派生为“硬件 UART 数量 + TMC2209 单线端口容量”。
      此兼容符号供当前 Remote Core 分配逻辑 UART 对象，不能手工设置。

choice UART0_PINS
    prompt "UART 0（USART1）引脚"
    depends on (BOARD_STM32F072RBT6 || BOARD_STM32F103CBT6 || BOARD_STM32G431CBU6) && HARDWARE_UART_RESOURCE_COUNT > 0
    default UART0_PINS_PA9_PA10

config UART0_PINS_PA9_PA10
    bool "USART1：PA9(TX) / PA10(RX)"

config UART0_PINS_PB6_PB7
    bool "USART1 重映射：PB6(TX) / PB7(RX)"

endchoice

config UART1_PINS_PA2_PA3
    bool
    default y
    depends on (BOARD_STM32F103CBT6 || BOARD_STM32G431CBU6) && HARDWARE_UART_RESOURCE_COUNT > 1
    help
      UART 1固定使用USART2：PA2(TX) / PA3(RX)。当前支持的F103/G431封装均
      不提供另一组完整且不占用SWD的有效端点，因此不显示无效候选项。

config UART2_PINS_PB10_PB11
    bool
    default y
    depends on (BOARD_STM32F103CBT6 || BOARD_STM32G431CBU6) && HARDWARE_UART_RESOURCE_COUNT > 2
    help
      UART 2固定使用USART3：PB10(TX) / PB11(RX)。G431虽然还可使用
      PC10/PC11，但当前板卡端点统一固定为PB10/PB11。

config UART_RX_BUFFER_SIZE
    int "每路硬件 UART RX 缓冲长度" if HARDWARE_UART_RESOURCE_COUNT > 0
    range 64 4096
    default 256 if BOARD_STM32F072RBT6
    default 256 if BOARD_STM32F103CBT6
    default 1024 if BOARD_STM32G431CBU6

config UART_TX_BUFFER_SIZE
    int "每路硬件 UART TX 缓冲长度" if HARDWARE_UART_RESOURCE_COUNT > 0
    range 64 4096
    default 256 if BOARD_STM32F072RBT6
    default 256 if BOARD_STM32F103CBT6
    default 1024 if BOARD_STM32G431CBU6

config UART_EVENT_CHUNK_SIZE
    int "UART 流式接收事件分批长度"
    range 8 256
    default 64
    depends on HARDWARE_UART_RESOURCE_COUNT > 0 || REMOTEBSP_TMC2209_UART
    help
      从硬件 RX 环形缓冲区批量取出数据并主动上报。
      数值越大，CAN 效率越高；数值越小，串口接收延迟越低。

config UART_EVENT_FLUSH_MS
    int "UART 流式接收最大合并延迟（毫秒）"
    range 1 100
    default 5
    depends on HARDWARE_UART_RESOURCE_COUNT > 0 || REMOTEBSP_TMC2209_UART
    help
      分批未满时，第一个字节最多等待此时间后上报。

config REMOTEBSP_SOFT_HALF_DUPLEX_UART
    bool
    default y if REMOTEBSP_TMC2209_UART
    default n
    depends on BOARD_STM32F072RBT6 || BOARD_STM32F103CBT6 || BOARD_STM32G431CBU6

config SOFT_HALF_DUPLEX_UART_BAUD
    int
    default 40000
    depends on REMOTEBSP_SOFT_HALF_DUPLEX_UART

