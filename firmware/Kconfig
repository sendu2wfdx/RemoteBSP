mainmenu "Remote BSP 工具板固件配置"

choice
    prompt "目标核心板"
    default BOARD_STM32F103CBT6

config BOARD_STM32F103CBT6
    bool "STM32F103CBT6（128KB Flash / 20KB SRAM / bxCAN）"

config BOARD_STM32F072RBT6
    bool "STM32F072RBT6（128KB Flash / 16KB SRAM / bxCAN）"

config BOARD_STM32G431CBU6
    bool "STM32G431CBU6（128KB Flash / 32KB SRAM / FDCAN）"
endchoice

config BOARD_MELLOW_FLY_D5
    bool "STM32F072RBT6 / Mellow FLY-D5 板级默认映射（可选）"
    depends on BOARD_STM32F072RBT6
    default n
    help
      仅为已知的 FLY-D5 接线预填 8MHz HSE、PB8/PB9 CAN、USB 保留和五个运动槽的
      默认引脚。取消本项后，STM32F072RBT6 仍可手工配置 CAN、运动槽、限位和 TMC2209 通讯引脚。

config BOARD_WEACT_BLUEPILL_PLUS
    bool "STM32F103CBT6 / WeAct BluePill Plus 板级外设"
    depends on BOARD_STM32F103CBT6
    default n
    help
      PA0 为高电平按下的用户按键，使用 MCU 内部下拉；PB2 为高电平点亮
      的蓝色 LED；PA11/PA12 分别为 USB DM/DP。

config BOARD_WEACT_G431_CORE_V10
    bool "STM32G431CBU6 / WeAct STM32G431CBU6 Core 板级外设"
    depends on BOARD_STM32G431CBU6
    default n
    help
      PB8/BOOT0 带 10k 下拉，PB8/PB9 用于 FDCAN；PA11/PA12 用于
      USB DM/DP。PC13 用户按键高电平有效且无外部上下拉，PC6 蓝色
      LED 高电平点亮。PF0/PF1 接 8MHz HSE，PC14/PC15 接 32.768kHz LSE。

choice F072_CLOCK_SOURCE
    prompt "STM32F072 系统时钟源"
    depends on BOARD_STM32F072RBT6
    default F072_CLOCK_HSE_8MHZ if BOARD_MELLOW_FLY_D5
    default F072_CLOCK_HSI48

config F072_CLOCK_HSI48
    bool "内部 HSI48"

config F072_CLOCK_HSE_8MHZ
    bool "外部 8MHz HSE（PLL 到 48MHz）"
    help
      本板默认使用 8MHz 外部晶振。CAN 使用外部晶振可满足 1Mbit/s 对节点时钟
      误差的要求；选择该项时 SYSCLK/PCLK1 仍为 48MHz。

endchoice

config F072_RESERVE_USB_PINS
    bool "保留 PA11/PA12 给 USB"
    depends on BOARD_STM32F072RBT6
    default y if BOARD_MELLOW_FLY_D5
    default n
    help
      启用后，普通 GPIO 与运动槽配置均不能占用 PA11/PA12。仅在板上确实接有 USB
      或需要保留其功能时选择；FLY-D5 默认映射会自动启用本项。

choice
    prompt "STM32G431 系统时钟源"
    depends on BOARD_STM32G431CBU6
    default G431_CLOCK_HSE_8MHZ if BOARD_WEACT_G431_CORE_V10
    default G431_CLOCK_HSI16

config G431_CLOCK_HSI16
    bool "内部 HSI16"

config G431_CLOCK_HSE_8MHZ
    bool "外部 8MHz HSE"
endchoice

config WEACT_G431_PC6_PWM_BREATHING_LED
    bool "WeAct G431 PC6 PWM 呼吸灯演示"
    depends on BOARD_WEACT_G431_CORE_V10
    default y
    help
      使用 TIM3_CH1（PC6，AF2）输出 10kHz PWM。亮度按约 4 秒一个
      周期缓慢起伏，用于验证定时器、PWM 输出和板载 LED。启用时 PC6
      被该演示独占，不能再作为远程 GPIO 使用；关闭后 PC6 恢复为普通 GPIO。

config WEACT_BLUEPILL_PLUS_PB2_BREATHING_LED
    bool "WeAct BluePill Plus PB2 软件呼吸灯演示"
    depends on BOARD_WEACT_BLUEPILL_PLUS
    default y
    help
      使用板载高电平点亮的 PB2 LED。PB2 不具备可直接使用的 PWM 输出通道，
      固件在主循环中依据 1ms 系统节拍产生约 100Hz 的软件 PWM，并按约 4 秒
      周期改变占空比。该实现不新增定时器中断，不影响 CAN 接收、UART 中断或
      可选的运动定时器。关闭后 PB2 保持熄灭，并继续保留为板载 LED。

config SYSTEM_CLOCK_HZ
    int "系统时钟频率"
    default 48000000 if BOARD_STM32F072RBT6
    default 72000000 if BOARD_STM32F103CBT6
    default 170000000 if BOARD_STM32G431CBU6

config FIRMWARE_VERSION_MAJOR
    int "固件主版本号"
    range 0 65535
    default 0

config FIRMWARE_VERSION_MINOR
    int "固件次版本号"
    range 0 65535
    default 1

config FIRMWARE_VERSION_PATCH
    int "固件修订版本号"
    range 0 65535
    default 0

config BOARD_TYPE
    hex "板卡类型编号"
    default 0xF072D5 if BOARD_MELLOW_FLY_D5
    default 0x0072B6 if BOARD_STM32F072RBT6
    default 0x0103CB if BOARD_STM32F103CBT6
    default 0x0431CB if BOARD_STM32G431CBU6

config NODE_PROVISIONAL_ID
    int "未分配节点的临时编号"
    range 1 127
    default 1

choice
    prompt "CAN/FDCAN 引脚组"
    default CAN_PINS_PB8_PB9 if BOARD_MELLOW_FLY_D5
    default CAN_PINS_PB8_PB9 if BOARD_WEACT_G431_CORE_V10
    default CAN_PINS_PA11_PA12

config CAN_PINS_PA11_PA12
    bool "PA11=RX、PA12=TX"

config CAN_PINS_PB8_PB9
    bool "PB8=RX、PB9=TX"
endchoice

config CAN_NOMINAL_BITRATE
    int "CAN 仲裁段波特率"
    range 10000 1000000
    default 1000000 if BOARD_MELLOW_FLY_D5
    default 500000

config CAN_FD_ENABLE
    bool "启用 CAN-FD"
    default y if BOARD_STM32G431CBU6
    depends on BOARD_STM32G431CBU6

config CAN_FD_DATA_BITRATE
    int "CAN-FD 数据段波特率"
    range 1000000 8000000
    default 2000000
    depends on CAN_FD_ENABLE

config CAN_TRANSCEIVER_STB_ENABLE
    bool "使用 GPIO 控制收发器 STB"
    default n

config CAN_TRANSCEIVER_STB_PORT
    string "STB GPIO 端口"
    default "B"
    depends on CAN_TRANSCEIVER_STB_ENABLE

config CAN_TRANSCEIVER_STB_PIN
    int "STB GPIO 引脚号"
    range 0 15
    default 0
    depends on CAN_TRANSCEIVER_STB_ENABLE

config REMOTE_MAX_PACKET_SIZE
    int "最大远程协议包长度"
    range 256 2048
    default 2048 if BOARD_STM32F072RBT6
    default 2048 if BOARD_STM32F103CBT6
    default 2048 if BOARD_STM32G431CBU6

config REMOTE_REQUEST_CACHE_ENTRIES
    int "请求去重缓存条目数"
    range 2 32
    default 8 if BOARD_STM32F072RBT6
    default 8 if BOARD_STM32F103CBT6
    default 16 if BOARD_STM32G431CBU6

config REMOTE_CACHE_RESPONSE_SIZE
    int "单条去重缓存的最大响应长度"
    range 64 512
    default 256
    help
      此长度包含 24 字节远程协议头。会消耗数据或产生副作用的命令，
      必须把完整响应限制在此长度内，才能保证重试不会重复执行操作。

config REMOTE_REASSEMBLY_SLOTS
    int "并行分片重组槽数量"
    range 1 4
    default 2

config REMOTE_REASSEMBLY_TIMEOUT_MS
    int "分片重组超时（毫秒）"
    range 50 5000
    default 500

config HEARTBEAT_INTERVAL_MS
    int "心跳间隔（毫秒）"
    range 100 2000
    default 500

menu "上电 IO 安全状态"

config STARTUP_GPIO_OUTPUT_LOW
    string "启动后输出低的引脚列表"
    default ""
    help
      使用逗号分隔，例如 PA1,PB2。固件会先写入低电平锁存值，再把引脚
      切换为推挽输出，避免切换过程产生高电平毛刺。

config STARTUP_GPIO_OUTPUT_HIGH
    string "启动后输出高的引脚列表"
    default ""
    help
      使用逗号分隔，例如 PA3,PC13。固件会先写入高电平锁存值，再把引脚
      切换为推挽输出。

config STARTUP_GPIO_INPUT_FLOATING
    string "启动后浮空输入的引脚列表"
    default ""

config STARTUP_GPIO_INPUT_PULLUP
    string "启动后上拉输入的引脚列表"
    default ""

config STARTUP_GPIO_INPUT_PULLDOWN
    string "启动后下拉输入的引脚列表"
    default ""
    help
      五个列表都使用 PA0,PB2 形式。同一引脚不能重复，SWD、CAN、USB、UART
      等保留引脚不能配置；非法配置会让固件进入安全故障状态。

endmenu

config GPIO_RESOURCE_COUNT
    int "暴露的 GPIO 数量"
    range 1 32
    default 16 if BOARD_MELLOW_FLY_D5
    default 8

config UART_RESOURCE_COUNT
    int "暴露的 UART 数量" if !REMOTEBSP_SOFT_HALF_DUPLEX_UART
    range 0 8
    default SOFT_HALF_DUPLEX_UART_PORT_COUNT if REMOTEBSP_SOFT_HALF_DUPLEX_UART
    default 1 if BOARD_STM32F072RBT6
    default 1 if BOARD_STM32F103CBT6
    default 0 if BOARD_STM32G431CBU6

choice UART0_PINS
    prompt "STM32F072/F103 UART 0 引脚" if !REMOTEBSP_SOFT_HALF_DUPLEX_UART
    depends on (BOARD_STM32F072RBT6 || BOARD_STM32F103CBT6) && UART_RESOURCE_COUNT > 0 && !REMOTEBSP_SOFT_HALF_DUPLEX_UART
    default UART0_PINS_PA9_PA10

config UART0_PINS_PA9_PA10
    bool "USART1：PA9(TX) / PA10(RX)"

config UART0_PINS_PB6_PB7
    bool "USART1 重映射：PB6(TX) / PB7(RX)"

endchoice

config UART_RX_BUFFER_SIZE
    int "每路 UART RX 缓冲长度" if !REMOTEBSP_SOFT_HALF_DUPLEX_UART
    range 64 4096
    default 256 if BOARD_STM32F072RBT6
    default 256 if BOARD_STM32F103CBT6
    default 1024 if BOARD_STM32G431CBU6

config UART_TX_BUFFER_SIZE
    int "每路 UART TX 缓冲长度" if !REMOTEBSP_SOFT_HALF_DUPLEX_UART
    range 64 4096
    default 256 if BOARD_STM32F072RBT6
    default 256 if BOARD_STM32F103CBT6
    default 1024 if BOARD_STM32G431CBU6

config UART_EVENT_CHUNK_SIZE
    int "UART 流式接收事件分批长度"
    range 8 256
    default 64
    depends on UART_RESOURCE_COUNT > 0
    help
      从硬件 RX 环形缓冲区批量取出数据并主动上报。
      数值越大，CAN 效率越高；数值越小，串口接收延迟越低。

config UART_EVENT_FLUSH_MS
    int "UART 流式接收最大合并延迟（毫秒）"
    range 1 100
    default 5
    depends on UART_RESOURCE_COUNT > 0
    help
      分批未满时，第一个字节最多等待此时间后上报。

config REMOTEBSP_SOFT_HALF_DUPLEX_UART
    bool
    default n
    depends on BOARD_STM32F072RBT6 || BOARD_STM32F103CBT6 || BOARD_STM32G431CBU6

config SOFT_HALF_DUPLEX_UART_BAUD
    int
    default 40000
    depends on REMOTEBSP_SOFT_HALF_DUPLEX_UART

config SOFT_HALF_DUPLEX_UART_RX_BUFFER_SIZE
    int
    range 16 256
    default 64
    depends on REMOTEBSP_SOFT_HALF_DUPLEX_UART

config SOFT_HALF_DUPLEX_UART_PORT_COUNT
    int
    range 1 5
    default 5
    depends on REMOTEBSP_SOFT_HALF_DUPLEX_UART

menu "智能步进运动（可选）"

config REMOTEBSP_MOTION
    bool "编译智能步进运动模块"
    default n
    depends on BOARD_STM32F072RBT6 || BOARD_STM32F103CBT6 || BOARD_STM32G431CBU6
    help
      启用带绝对时间的多轴运动段队列和定时器 STEP 执行器。关闭时不编译
      运动源文件，也不在 Remote Core 中分配轴状态和运动段队列。

      STM32F072RBT6、STM32F103CBT6 与 STM32G431CBU6 都有独立的 STEP 定时器后端。默认预设
      只负责填写已知接线；不选择预设时仍可手工配置本板运动槽和引脚。

if REMOTEBSP_MOTION

