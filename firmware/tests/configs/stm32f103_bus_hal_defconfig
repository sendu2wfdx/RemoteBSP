# F103 单板 I2C/SPI HAL 交叉编译配置；默认产品配置仍关闭 BUS。
CONFIG_BOARD_STM32F103CBT6=y
CONFIG_F103_CLOCK_HSE_8MHZ=y
CONFIG_SYSTEM_CLOCK_HZ=72000000
CONFIG_BOARD_TYPE=0x0103CB
CONFIG_NODE_PROVISIONAL_ID=1
CONFIG_CAN_PINS_PA11_PA12=y
CONFIG_CAN_NOMINAL_BITRATE=500000
CONFIG_REMOTE_MAX_PACKET_SIZE=2048
CONFIG_REMOTE_REQUEST_CACHE_ENTRIES=8
CONFIG_REMOTE_CACHE_RESPONSE_SIZE=256
CONFIG_REMOTE_REASSEMBLY_SLOTS=2
CONFIG_REMOTE_REASSEMBLY_TIMEOUT_MS=500
CONFIG_HEARTBEAT_INTERVAL_MS=500
CONFIG_GPIO_RESOURCE_COUNT=8
CONFIG_HARDWARE_UART_RESOURCE_COUNT=1
CONFIG_UART0_PINS_PA9_PA10=y
CONFIG_UART_RX_BUFFER_SIZE=256
CONFIG_UART_TX_BUFFER_SIZE=256
CONFIG_REMOTEBSP_BUS=y
CONFIG_REMOTEBSP_BUS_RESOURCE_COUNT=4
CONFIG_REMOTEBSP_BUS_MAX_TRANSFER_BYTES=128
CONFIG_REMOTEBSP_BUS_MIN_TIMEOUT_US=100
CONFIG_REMOTEBSP_BUS_MAX_TIMEOUT_US=100000
CONFIG_F103_BUS_I2C1_PB6_PB7=y
CONFIG_F103_BUS_I2C1_DEVICE_ADDRESS=72
CONFIG_F103_BUS_SPI1_PA5_PA6_PA7_CS_PA4=y
CONFIG_REMOTEBSP_PWM=n
CONFIG_REMOTEBSP_TIMED_BITSTREAM=n
CONFIG_REMOTEBSP_MOTION=n
CONFIG_APP_LAYOUT_STANDALONE=y
CONFIG_APPLICATION_FLASH_OFFSET=0x0
