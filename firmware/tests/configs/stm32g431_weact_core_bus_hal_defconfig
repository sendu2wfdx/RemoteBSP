# G431 单板 I2C/SPI HAL 交叉编译配置；仅用于开发验证，不是正式板卡预设。
# SPI1 使用 PA6，因此不得在逻辑分析仪 PWM 接线保持连接时烧录此固件。
CONFIG_BOARD_STM32G431CBU6=y
CONFIG_BOARD_WEACT_G431_CORE_V10=y
CONFIG_G431_CLOCK_HSE_8MHZ=y
CONFIG_BOARD_HAS_LSE_32768=y
CONFIG_STARTUP_GPIO_OUTPUT_LOW="PC6"
CONFIG_STARTUP_GPIO_INPUT_PULLDOWN="PC13"
CONFIG_SYSTEM_CLOCK_HZ=170000000
CONFIG_FIRMWARE_VERSION_MAJOR=0
CONFIG_FIRMWARE_VERSION_MINOR=1
CONFIG_FIRMWARE_VERSION_PATCH=0
CONFIG_BOARD_TYPE=0x0431CB
CONFIG_NODE_PROVISIONAL_ID=1
CONFIG_CAN_PINS_PB8_PB9=y
CONFIG_CAN_NOMINAL_BITRATE=500000
CONFIG_CAN_FD_ENABLE=y
CONFIG_CAN_FD_DATA_BITRATE=1000000
CONFIG_REMOTE_MAX_PACKET_SIZE=2048
CONFIG_REMOTE_REQUEST_CACHE_ENTRIES=16
CONFIG_REMOTE_CACHE_RESPONSE_SIZE=256
CONFIG_REMOTE_REASSEMBLY_SLOTS=2
CONFIG_REMOTE_REASSEMBLY_TIMEOUT_MS=500
CONFIG_HEARTBEAT_INTERVAL_MS=500
CONFIG_GPIO_RESOURCE_COUNT=8
CONFIG_REMOTEBSP_BUS=y
CONFIG_REMOTEBSP_BUS_RESOURCE_COUNT=6
CONFIG_REMOTEBSP_BUS_MAX_TRANSFER_BYTES=128
CONFIG_REMOTEBSP_BUS_MIN_TIMEOUT_US=100
CONFIG_REMOTEBSP_BUS_MAX_TIMEOUT_US=100000
CONFIG_G431_BUS_I2C1_PB6_PB7=y
CONFIG_G431_BUS_I2C1_DEVICE_ADDRESS=72
CONFIG_G431_BUS_SPI1_PA5_PA6_PA7_CS_PA15=y
CONFIG_G431_BUS_SPI2_PB13_PB14_PB15_CS_PB12=y
CONFIG_HARDWARE_UART_RESOURCE_COUNT=1
CONFIG_UART0_PINS_PA9_PA10=y
CONFIG_UART_RX_BUFFER_SIZE=256
CONFIG_UART_TX_BUFFER_SIZE=256
CONFIG_REMOTEBSP_PWM=n
CONFIG_REMOTEBSP_TIMED_BITSTREAM=n
CONFIG_REMOTEBSP_MOTION=n
CONFIG_APP_LAYOUT_STANDALONE=y
CONFIG_APPLICATION_FLASH_OFFSET=0x0
