    default MOTION_SLOT0_ENABLE_ACTIVE_LOW if MOTION_SLOT2_ENABLE_SHARE_SLOT0
    default MOTION_SLOT1_ENABLE_ACTIVE_LOW if MOTION_SLOT2_ENABLE_SHARE_SLOT1
    default MOTION_SLOT2_ENABLE_ACTIVE_LOW_SETTING

choice MOTION_SLOT2_DRIVER
    prompt "槽 2 步进驱动器"
    default MOTION_SLOT2_DRIVER_TMC2209_UART if BOARD_MELLOW_FLY_D5
    default MOTION_SLOT2_DRIVER_STEP_DIR
config MOTION_SLOT2_DRIVER_STEP_DIR
    bool "通用 STEP/DIR 驱动器"
config MOTION_SLOT2_DRIVER_TMC2209_UART
    bool "TMC2209（STEP/DIR + 单线 UART）"
    select REMOTEBSP_TMC2209_UART
endchoice

