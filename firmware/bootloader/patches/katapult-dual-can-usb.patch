diff --git a/src/generic/dual_interface.c b/src/generic/dual_interface.c
new file mode 100644
index 0000000..af4e7e0
--- /dev/null
+++ b/src/generic/dual_interface.c
@@ -0,0 +1,33 @@
+// 为 CAN/USB 双模式 Katapult 提供运行时传输接口选择。
+//
+// 本文件可按 GNU GPLv3 许可证发布。
+
+#include <stdarg.h> // va_list
+#include "autoconf.h" // CONFIG_*
+#include "bootentry.h" // bootentry_is_usb
+#include "command.h" // command_encoder
+#include "generic/canserial.h" // can_console_sendf
+#include "generic/usb_cdc.h" // usb_console_sendf
+
+void
+console_sendf(const struct command_encoder *ce, va_list args)
+{
+    if (bootentry_is_usb())
+        usb_console_sendf(ce, args);
+    else
+        can_console_sendf(ce, args);
+}
+
+#if CONFIG_MACH_STM32F1
+void CAN_IRQHandler(void);
+void USB_IRQHandler(void);
+
+void
+dual_usb_can_irq(void)
+{
+    if (bootentry_is_usb())
+        USB_IRQHandler();
+    else
+        CAN_IRQHandler();
+}
+#endif
