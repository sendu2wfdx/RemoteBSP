{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remotebsp.local/schema/run-manifest-v1.schema.json",
  "title": "RemoteBSP / Klipper 配对基准运行记录 v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "format", "run_id", "plan_sha256", "started_at",
    "completed_at", "operator_id", "environment_digest", "systems", "scenarios"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "format": {"const": "REMOTEBSP_KLIPPER_BENCHMARK_RUN_V1"},
    "run_id": {"$ref": "#/$defs/id"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "started_at": {"$ref": "#/$defs/time"},
    "completed_at": {"$ref": "#/$defs/time"},
    "operator_id": {"$ref": "#/$defs/id"},
    "environment_digest": {"$ref": "#/$defs/sha256"},
    "systems": {
      "type": "object", "additionalProperties": false,
      "required": ["remotebsp", "klipper"],
      "properties": {
        "remotebsp": {"$ref": "#/$defs/system"},
        "klipper": {"$ref": "#/$defs/system"}
      }
    },
    "scenarios": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {"$ref": "#/$defs/scenario"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,95}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "time": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "system": {
      "type": "object", "additionalProperties": false,
      "required": [
        "revision", "host_config_sha256", "firmware_config_sha256s",
        "firmware_image_sha256s"
      ],
      "properties": {
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "host_config_sha256": {"$ref": "#/$defs/sha256"},
        "firmware_config_sha256s": {
          "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "firmware_image_sha256s": {
          "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "unit", "remotebsp", "klipper"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "unit": {"enum": ["ns", "us", "ms", "count", "percent", "bytes_per_second"]},
        "remotebsp": {"$ref": "#/$defs/measurement"},
        "klipper": {"$ref": "#/$defs/measurement"}
      }
    },
    "measurement": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "sample_count"],
      "properties": {
        "value": {"type": "number"},
        "sample_count": {"type": "integer", "minimum": 1, "maximum": 100000000}
      }
    },
    "rawFile": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 240},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 4294967296}
      }
    },
    "scenario": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "safety_failure", "metrics", "raw_files"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["passed", "failed"]},
        "safety_failure": {"type": "boolean"},
        "metrics": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {"$ref": "#/$defs/metric"}
        },
        "raw_files": {
          "type": "array", "minItems": 1, "maxItems": 64,
          "items": {"$ref": "#/$defs/rawFile"}
        }
      }
    }
  }
}
